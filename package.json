{
  "name": "ancestry",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Stammbaum — a pocket who-is-who for family gatherings",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --ssr server/main.ts --outDir dist-server",
    "build:single": "tsc --noEmit && vite build --mode single",
    "start": "node dist-server/main.js",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.2",
    "daisyui": "^5.7.35",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-singlefile": "^2.0.3",
    "vitest": "^2.1.4"
  },
  "dependencies": {
    "country-flag-emoji-polyfill": "^0.1.8"
  }
}
